# ===== 大模型（智谱 GLM / OpenAI 兼容接口）=====
# 必填；留空时应用以演示模式运行（无工具调用、无图片识别）
zhipuai_api_key=
zhipuai_base_url=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-5.2
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=30
LLM_MAX_TOKENS=2048

# ===== 数据库（MySQL）=====
# 未配置 DB_HOST/DB_USER/DB_DATABASE 时自动使用 SQLite 演示模式
DEMO_MODE=1
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=oa_demo
SQL_MAX_ROWS=200
# 默认只读：LLM 生成的 SQL 仅允许 SELECT / WITH
SQL_READ_ONLY=1
SQL_ALLOW_DML=0

# ===== RAG 知识库 =====
RAG_DB_PATH=./data/rag.sqlite3
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=80
RAG_TOP_K=4
RAG_EMBEDDING_MODEL=embedding-3
RAG_EMBEDDING_ENABLED=1
KNOWLEDGE_BASE_DIR=./knowledge_base
HISTORY_LIMIT=20

# ===== QQ 邮箱 SMTP（选填）=====
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USER=
MAIL_PASS=
MAIL_SENDER=

# ===== 高德地图（选填）=====
AMAP_API_KEY=

# ===== 文件与图片 =====
UPLOAD_CACHE_DIR=./upload_cache
DOC_MAX_LENGTH=30000
YOLO_MODEL_PATH=./yolo11n.pt
MAX_UPLOAD_SIZE_MB=50

# ===== 服务 =====
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
